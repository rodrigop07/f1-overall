# Portas expostas no host (padrão escolhido para não colidir com serviços em 3000/8000)
FRONTEND_PORT=8080
BACKEND_PORT=8010

# Executa `python -m app.cli bootstrap --skip-fastf1` automaticamente se o banco estiver vazio
AUTO_BOOTSTRAP=true

# UID/GID locais proprietários de ./backend/data (evita erro de permissão em SQLite WAL)
UID=1000
GID=1000

# Opcional: token F1 TV para enriquecimento adicional via FastF1
FASTF1_TOKEN=
